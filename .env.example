# MariaDB/MySQL connection (create the database with database/schema.sql first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=florastudio

# Set a random secret with at least 32 characters before deploying.
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Accounts are created on first database initialization if the users table is empty.
# Change these defaults before the first run on any non-local environment.
ADMIN_EMAIL=admin@florastudio.id
ADMIN_PASSWORD=admin123
USER_EMAIL=user@florastudio.id
USER_PASSWORD=user123
